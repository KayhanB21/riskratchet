{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KayhanB21/riskratchet/schemas/baseline.schema.json",
  "title": "riskratchet baseline file",
  "description": "Format of `.riskratchet.json` written by `riskratchet baseline`.",
  "type": "object",
  "required": ["version", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "enum": ["1", "2", "3"] },
    "identity": {
      "type": "object",
      "description": "Baseline v3 (0.3.0): per-non-Python-language fingerprint provenance (scheme + pinned grammar the persisted fingerprints were made with). Present only when an entry for that language exists; absent from a Python-only baseline.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scheme": { "type": "integer", "minimum": 1 },
          "grammar": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "qualname", "score", "components"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "qualname": { "type": "string" },
          "fingerprint": { "type": "string" },
          "signature": { "type": "string" },
          "group": { "type": "string" },
          "language": {
            "enum": ["python", "typescript"],
            "description": "Baseline v3 (0.3.0): analyzer backend language. Omitted (defaults \"python\") on Python entries for byte stability; present on TypeScript entries."
          },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "components": {
            "type": "object",
            "required": [
              "coverage_gap",
              "structural_complexity",
              "branch_gap",
              "churn",
              "public_surface",
              "sprawl"
            ],
            "additionalProperties": false,
            "properties": {
              "coverage_gap": { "type": "number" },
              "structural_complexity": { "type": "number" },
              "branch_gap": { "type": "number" },
              "churn": { "type": "number" },
              "public_surface": { "type": "number" },
              "sprawl": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
